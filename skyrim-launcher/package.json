{
  "name": "skyrim-rp-launcher",
  "version": "1.0.0",
  "description": "Launcher Ejecutable para Skyrim RP (SkyMP)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "author": "SkyMP Admin",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.skymp.launcher",
    "productName": "Skyrim RP Launcher",
    "asarUnpack": [
      "**/node_modules/7zip-bin/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "adm-zip": "^0.6.1",
    "axios": "^1.20.0",
    "fs-extra": "^11.4.0",
    "node-7z": "^3.0.0"
  }
}